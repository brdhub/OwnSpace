{
  "name": "ownspace",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=20.16.0 <21 || >=22.3.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node -e \"require('fs').mkdirSync('data',{recursive:true})\" && drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:init": "tsx scripts/seed.ts --defaults-only",
    "db:seed": "tsx scripts/seed.ts",
    "db:clear": "tsx scripts/clear-local-data.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.2",
    "lucide-react": "^0.468.0",
    "next": "^15.3.4",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.32",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
